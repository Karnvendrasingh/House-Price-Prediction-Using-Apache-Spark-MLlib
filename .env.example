# GlobalEstate AI - Environment Variables Template
# INT315 - Cluster Computing Project

# API Configuration
PROJECT_NAME="GlobalEstate AI"
VERSION="1.0.0"
API_PREFIX="/api"

# Apache Spark Cluster Settings
SPARK_APP_NAME="GlobalEstateAI-SparkEngine"
SPARK_MASTER="local[*]"
SPARK_DRIVER_MEMORY="2g"
SPARK_EXECUTOR_MEMORY="2g"
SPARK_SHUFFLE_PARTITIONS=4
SPARK_LOG_LEVEL="WARN"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api"

